# ==============================================================================
# OMNIS - Environment Variables
# ==============================================================================
# Copy this file to .env and edit it: cp .env.example .env
# .env is gitignored, so the passwords you set there never reach the repo. Change every
# "change-me" before running the stack anywhere but on your own machine.

# ------------------------------------------------------------------------------
# PostgreSQL warehouse
# ------------------------------------------------------------------------------
# Port of the warehouse on the host, to connect a SQL client or a BI tool
POSTGRES_HOST_PORT=5432
POSTGRES_DB=omnis
# Superuser of the warehouse, which only its init, its backups and whoever creates logins use.
# People and tools log in with a login of their own (see "Roles and logins" in README.md)
POSTGRES_USER=omnis
POSTGRES_PASSWORD=change-me
# Password of omnis_airflow, the role the flows read and write the warehouse with. Only Airflow uses
# it, so it can be any random string. Changing it takes effect on the next start
POSTGRES_AIRFLOW_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Airflow
# ------------------------------------------------------------------------------
# User the Airflow containers run as, and so the owner of the logs they write. On Linux, the
# output of `id -u`: 1000 is the first user of most distributions, Raspberry Pi OS included. On
# Windows and macOS any value works
AIRFLOW_UID=1000
# Port of the Airflow UI on the host
AIRFLOW_WEB_PORT=8080
# Admin user of the Airflow UI, created on the first start
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Storage (the landing zone of the raw files)
# ------------------------------------------------------------------------------
# Who can deliver files to omnis-storage: name:password pairs separated by commas, as many as you
# want (one per producer, or one shared by several). The name only shows in its log. A password
# can't contain a comma. Changing them takes effect on the next start
STORAGE_USERS=producer:change-me
# Port of omnis-storage on the host, where producers deliver the files (POST /raw/<entity>)
STORAGE_PORT=9000

# ------------------------------------------------------------------------------
# Failure alerts
# ------------------------------------------------------------------------------
# Who gets an e-mail when a run of a flow or a monthly backup fails. Leave any of these empty
# (but SMTP_PORT) and no e-mails are sent
ALERT_EMAIL=
# SMTP server the e-mails are sent through, as SMTP_USER, who is also the sender. Port 465 uses
# TLS, any other STARTTLS. Gmail: smtp.gmail.com, 587, and an app password (not the account's)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
