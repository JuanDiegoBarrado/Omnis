# Env file
.env

# Python env files
.venv
.pytest_cache/
**/__pycache__/

# Claude generated files
CLAUDE.md

# Omnis database
omnis-database/data
# The backups, as the raw files below: the folder exists on clone, owned by whoever cloned
omnis-database/backups/*
!omnis-database/backups/.gitkeep

# Omnis storage: the raw files and their backups (data/ exists on clone, owned by whoever cloned)
omnis-storage/backups/*
!omnis-storage/backups/.gitkeep
omnis-storage/minio_storage
omnis-storage/data/*
!omnis-storage/data/.gitkeep
# temp/ too, which Hermes mounts
!omnis-storage/data/temp/
omnis-storage/data/temp/*
!omnis-storage/data/temp/.gitkeep

# Omnis airflow
omnis-airflow/logs
# Generated by airflow-init on the first start, with random keys of its own on every machine
omnis-airflow/config/airflow.cfg
